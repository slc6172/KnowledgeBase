# 依賴套件——用 package-lock.json 重建,不進版控
node_modules/

# clasp 本地部署設定——含實際的 Apps Script 專案 scriptId,每個人各自的部署
# 目標不同,不該共用/進版控。.clasp.json.example 是範本,留著。
.clasp.json

# 編輯器/作業系統雜項
.DS_Store
*.swp
.vscode/
.idea/

# 測試/覆蓋率輸出
coverage/

# /mycr 深度掃描報告——可能包含程式弱點細節，不該進版控
.mycr/

# Supabase CLI 本地檔案——`supabase link` 會在 .temp/ 寫入專案 ref 與連線資訊,
# 每個人的連結目標不同,不該共用/進版控。supabase/config.toml 與 functions/ 要提交。
supabase/.temp/
supabase/.branches/

# 環境變數檔——可能存放密鑰(例如本機測試用的 EDGE_PROXY_SECRET),絕不能進版控。
# 實際的密鑰只放在 Supabase 的 Edge Function secrets 與 GAS 的 Script Properties。
.env
.env.*
supabase/.env
supabase/.env.*
